{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://urban-alert.local/schemas/reporte.validado.v1.schema.json",
  "title": "reporte.validado v1",
  "description": "Publicado por ServicioReportes al transicionar RECIBIDO -> VALIDADO. Consumido por: ServicioObras (dispara la asignación de una obra), ServicioAuditoria.",
  "type": "object",
  "additionalProperties": false,
  "required": ["eventId", "eventType", "version", "occurredAt", "correlationId", "reportId", "data"],
  "properties": {
    "eventId":       { "type": "string", "format": "uuid" },
    "eventType":     { "const": "reporte.validado" },
    "version":       { "const": 1 },
    "occurredAt":    { "type": "string", "format": "date-time" },
    "correlationId": { "type": "string", "format": "uuid" },
    "reportId":      { "type": "string", "format": "uuid" },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actorId", "municipioId", "estadoPrevio", "estadoNuevo"],
      "properties": {
        "actorId":      { "type": "string", "format": "uuid", "description": "gestor o admin que validó el reporte" },
        "municipioId":  { "type": "string", "format": "uuid" },
        "estadoPrevio": { "const": "RECIBIDO" },
        "estadoNuevo":  { "const": "VALIDADO" },
        "motivo":       { "type": "string" }
      }
    }
  }
}
